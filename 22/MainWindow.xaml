<Window x:Class="_22.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_22"
        mc:Ignorable="d"
       Title="Библиотека" Height="750" Width="700">
    <StackPanel>

        <ScrollViewer Height="400" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="BookPanel" Background="LightYellow">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="10" Background="Beige"
                                    MouseEnter="StackPanel_MouseEnter"
                                    MouseLeave="StackPanel_MouseLeave"
                                    MouseDown="StackPanel_MouseDown">
                            <Image Source="{Binding Cover}" Width="120" Height="180" Stretch="UniformToFill"/>
                            <TextBlock Text="{Binding Title}" TextAlignment="Center" Width="140"
                                       FontWeight="Bold" TextWrapping="Wrap" Margin="5"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Text="Подробная информация о книге" FontWeight="Bold" FontSize="14" Margin="10"/>

        <StackPanel Margin="5">
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Название:" VerticalAlignment="Center" Width="180"/>
                <TextBox x:Name="txtName" Width="350" TextChanged="TxtName_TextChanged"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Автор:" VerticalAlignment="Center" Width="180"/>
                <TextBox x:Name="txtAuthor" Width="350" TextChanged="TxtAuthor_TextChanged"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Обложка (путь):" VerticalAlignment="Center" Width="180"/>
                <TextBox x:Name="txtCover" Width="350" TextChanged="TxtCover_TextChanged"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Количество в наличии:" VerticalAlignment="Center" Width="180"/>
                <TextBox x:Name="txtCount" Width="80" TextChanged="TxtCount_TextChanged"/>
                <TextBlock Text="На руках:" VerticalAlignment="Center" Margin="5"/>
            </StackPanel>
            <TextBlock x:Name="txtStatus" FontWeight="Bold" Margin="5"/>

        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Button Content="Добавить книгу" Width="140" Margin="5" Click="Button_Click"/>
            <Button Content="Удалить книгу"  Width="140" Margin="5" Click="Del_Click"/>
            <Button Content="Выдать книгу"   Width="140" Margin="5" Click="Take_Click"/>
            <Button Content="Вернуть книгу"  Width="140" Margin="5" Click="Return_Click"/>
        </StackPanel>

    </StackPanel>
</Window>